{
  "name": "@kyma-ai/client",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript client for the Kyma context engine API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "apache-arrow": "17.0.0", "zustand": "^4.5.0" },
  "devDependencies": {
    "typescript": "5.5.4",
    "vite": "5.4.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "2.0.5"
  }
}
