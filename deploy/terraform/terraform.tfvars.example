# Copy to terraform.tfvars and fill in. Secrets (passwords, URLs, tokens) are
# better passed via env: export TF_VAR_supabase_db_password=... etc.
#
# `pensieve deploy init` renders this file for you from the wizard answers.

project_name = "pensieve"
aws_region   = "us-east-1"

# ── Backend selectors ──────────────────────────────────────────────────────
# compute_backend : "fargate" (ECS) | "eks" (cluster provisioned here; the CLI
#                   then installs the Helm chart). helm/local are CLI-only.
# database_backend: "supabase" | "rds" | "external" (set database_url).
# storage_backend : "supabase" | "s3" | "external" (set storage_endpoint+keys).
# auth_backend    : "supabase" | "token" (set admin_token) | "oidc".
compute_backend  = "fargate"
database_backend = "supabase"
storage_backend  = "supabase"
auth_backend     = "supabase"

# ── Supabase (database/storage/auth = supabase) ─────────────────────────────
supabase_org_id = "your-org-id" # https://supabase.com/dashboard/org → settings
supabase_region = "us-east-1"
# Create S3 access keys in the dashboard (Project Settings → Storage), or let
# `pensieve deploy up` walk you through it:
# supabase_s3_access_key_id     = ""
# supabase_s3_secret_access_key = ""

# ── Bring-your-own Postgres (database_backend = "external") ─────────────────
# database_url = "postgresql://user:pass@host:5432/pensieve"   # via TF_VAR_database_url

# ── AWS RDS catalog (database_backend = "rds") ──────────────────────────────
# rds_instance_class = "db.t4g.micro"

# ── Bring-your-own S3-compatible storage (storage_backend = "external") ─────
# storage_endpoint   = "https://minio.example.com:9000"
# storage_bucket     = "pensieve"
# storage_region     = "us-east-1"
# storage_path_style = true
# storage_access_key = ""                # via TF_VAR_storage_access_key
# storage_secret     = ""                # via TF_VAR_storage_secret

# ── Auth: token / oidc (non-Supabase) ───────────────────────────────────────
# admin_token    = ""                    # via TF_VAR_admin_token (auth=token)
# oidc_issuer    = "https://issuer.example.com"
# oidc_client_id = "pensieve"

# Who gets the pensieve admin role (Supabase Auth / OIDC email claim).
admin_emails = ["you@company.com"]

# Lock sign-in to your team's email domain(s). Strongly recommended for the
# Supabase backend — without it anyone who can register gets read access.
allowed_email_domains = ["company.com"]

# OAuth providers to show on the login page (enable them in Supabase first).
oauth_providers = [] # e.g. ["google", "github"]

# Custom domain + automated TLS (recommended for production; Fargate).
# domain          = "pensieve.company.com"
# route53_zone_id = "Z0123456789ABC"

# ── EKS sizing (compute_backend = "eks") ────────────────────────────────────
# eks_kubernetes_version = "1.31"
# eks_instance_types     = ["t3.medium"]
# eks_desired_size       = 2

# Engine image — pin a released version.
image_tag = "latest"
