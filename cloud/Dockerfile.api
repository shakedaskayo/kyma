FROM node:22-alpine
RUN corepack enable
WORKDIR /app

COPY cloud/package.json cloud/pnpm-workspace.yaml cloud/pnpm-lock.yaml cloud/.npmrc ./
COPY cloud/packages/ packages/
COPY cloud/api/ api/

RUN pnpm install --frozen-lockfile --ignore-scripts

WORKDIR /app/api
EXPOSE 3003
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
