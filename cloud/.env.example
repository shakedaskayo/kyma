# kyma cloud control plane — secrets template.
# Copy to .env.local for local dev. Production values live in Railway / Vercel env.
# DO NOT commit the populated .env.local — it's gitignored.

# === Database ===
# The cloud control plane shares the kyma engine's Postgres in v1; we use
# a separate logical database via DRIZZLE_DATABASE_URL so migrations don't
# collide with kyma-catalog's sqlx migrations.
DRIZZLE_DATABASE_URL=postgres://kyma:kyma_dev@localhost:5434/kyma_cloud

# === GitHub OAuth ===
# Created at https://github.com/settings/developers
# Callback URL: <CLOUD_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Magic-link email (Resend) ===
# Created at https://resend.com/api-keys (use a sending API key, not full-access)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kyma.dev

# === Stripe ===
# Created at https://dashboard.stripe.com/test/apikeys (TEST MODE)
# Webhook signing secret: created when you register an endpoint
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=

# Stripe Price IDs per plan (created at https://dashboard.stripe.com/test/products)
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# === Session / cookie signing ===
# Generate locally with: openssl rand -base64 48
SESSION_SECRET=

# === MCP token issuance ===
# Bearer tokens minted by the cloud are stored as SHA-256 hashes in api_tokens
# (consumed by kyma-server's DbAuthBackend). No secret needed here — the
# kyma-server side uses the same Postgres pool.
KYMA_ENGINE_BASE_URL=https://mcp.kyma.dev

# === Cloud base URL ===
CLOUD_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CLOUD_BASE_URL=http://localhost:3001
